# Скопируйте в .env и заполните: cp .env.example .env

# Внешние порты (выбраны так, чтобы не конфликтовать с другими проектами)
# *_BIND: 127.0.0.1 — только локально, 0.0.0.0 — доступно извне (на сервере для frontend)
FRONTEND_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
FRONTEND_PORT=5180
BACKEND_PORT=8040
DB_EXTERNAL_PORT=5440

# База данных
DB_USER=ndktu
DB_PASSWORD=change_me
DB_NAME=ndktu_site

# Backend
ENV=development
ACCESS_SECRET_KEY=change_me
REFRESH_SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# Базовый адрес для ссылок на загруженные файлы
URL=http://localhost:5180
